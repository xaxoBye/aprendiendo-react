      "isDeleted": false,
      "boundElements": [],
      "updated": 1758564619917,
      "link": null,
      "locked": false,
      "text": "products.slice(0, 10).map (product => (\n    isProductInCart = checkProductInCart(product)\n\n    <img src= { product.thumbnail }\n          alt= { product.title }\n    <div>\n        <strong{ product.title } ${ product.price }\n    <div>\n        <button \n            onClick \n                isProductInCart\n                      ? removeFromCart(product)\n                      :  addToCart(product)>\n\n            isProductInCart\n                ? <RemoveFromCartonIcon/>\n                :  <AddToCartIcon />\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "products.slice(0, 10).map (product => (\n    isProductInCart = checkProductInCart(product)\n\n    <img src= { product.thumbnail }\n          alt= { product.title }\n    <div>\n        <strong{ product.title } ${ product.price }\n    <div>\n        <button \n            onClick \n                isProductInCart\n                      ? removeFromCart(product)\n                      :  addToCart(product)>\n\n            isProductInCart\n                ? <RemoveFromCartonIcon/>\n                :  <AddToCartIcon />\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
